// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ARENA_ADMIN
  RECEPTIONIST
  TEACHER
  ATHLETE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Sport {
  BEACH_TENNIS
  FOOTVOLLEY
  BEACH_VOLLEYBALL
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  PENDING
  RESERVED_LOCAL
  NO_SHOW
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PaymentCategory {
  BOOKING       // Recebimento de Agendamento
  BAR_SNACKBAR  // Lanchonete / Bar
  EQUIPMENT_RENTAL // Aluguel de Raquetes / Bolas
  SPONSORSHIP   // Patrocínio
  OTHER         // Outros
}

enum PaymentStatus {
  COMPLETED
  PENDING
  REFUNDED
}

enum BookingType {
  FREE_PLAY         // Locação Avulsa / ForFun
  SINGLE_LESSON     // Aula Livre (1 atleta ou avulso)
  GROUP_LESSON      // Aula Coletiva com Professor (múltiplos alunos pagando individualmente)
  RECURRING_LESSON  // Aula Fixa Semanal
  TOURNAMENT        // Campeonato / Evento (bloqueio de quadra em lote)
}

enum ParticipantStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String?
  phone        String?

  cpf           String?       @unique
  gender        Gender?
  birthDate     DateTime?
  city          String?
  state         String?

  avatarUrl    String?
  coverUrl     String?
  role         Role          @default(ATHLETE)
  btRating     Float         @default(1000.0) // Beach Tennis Rating
  footvolleyElo Float        @default(1000.0) // Footvolley Elo

  googleId      String?       @unique
  appleId       String?       @unique
  
  arenasManaged Arena[]  @relation("ArenaAdmins")
  activeArenaId String?
  arenaRequests ArenaRequest[]

  arenasEmployed Arena[]  @relation("ArenaStaff")

  sentInvites    StaffInvite[] @relation("SentInvites")

  bio           String?   // Apresentação do professor
  hourlyRate    Decimal?  @db.Decimal(10, 2) // Valor da hora/aula do professor

  payments Payment[]

  followedArenas ArenaFollower[]
  
  bookings     Booking[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  paymentsCreated Payment[] @relation("PaymentsCreated")

  coachBookings Booking[] @relation("CoachBookings")
  participations BookingParticipant[]

  @@map("users")
}

model Arena {
  id          String        @id @default(uuid())
  name        String
  cnpj       String?       @unique // CNPJ

  address      String?       
  number       String?      
  complement   String?      
  neighborhood String?       
  zipCode      String?      
  city         String
  state        String       

  isActive     Boolean       @default(true)

  logoUrl     String? 
  photos      String[]    @default([]) 

  operatingHours ArenaOperatingHour[]
  holidays       ArenaHoliday[]
  
  courts      Court[]
  bookings    Booking[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  admins    User[]   @relation("ArenaAdmins")
  staff     User[]   @relation("ArenaStaff")

  followers ArenaFollower[]

  invites   StaffInvite[]

  payments Payment[]

  @@map("arenas")
}

model ArenaRequest {
  id           String        @id @default(uuid())
  arenaName    String
  cnpj         String        // CNPJ
  address      String?
  city         String
  state        String
  phone        String?
  status       RequestStatus @default(PENDING)
  
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("arena_requests")
}

model Court {
  id          String        @id @default(uuid())
  name        String        // e.g., "Court 1 - Covered"
  sport       Sport
  hourlyRate  Decimal       @db.Decimal(10, 2)
  isCovered   Boolean       @default(false)
  isActive    Boolean       @default(true)

  photos      String[]  @default([])
  
  arenaId     String
  arena       Arena         @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  
  bookings    Booking[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("courts")
}

model Booking {
  id               String            @id @default(uuid())
  type             BookingType       @default(FREE_PLAY)
  status           BookingStatus     @default(PENDING)
  
  courtId          String
  arenaId          String
  userId           String?           // Quem criou ou atleta principal
  customerName     String?           // Nome caso criado no balcão sem cadastro
  coachId          String?           // Professor responsável (se for aula)

  startTime        DateTime
  endTime          DateTime
  
  totalAmount      Decimal           @db.Decimal(10, 2)
  pricePerPlayer   Decimal?          @db.Decimal(10, 2) // Preço individual se for GROUP_LESSON
  maxPlayers       Int?              // Limite de vagas na aula

  // Recorrência para Aula Fixa
  isRecurring      Boolean           @default(false)
  recurringGroupId String?           // Agrupa todas as semanas da mesma aula fixa
  recurrenceEnd    DateTime?

  // Campeonatos e Eventos
  tournamentName   String?
  notes            String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  court            Court             @relation(fields: [courtId], references: [id])
  arena            Arena             @relation(fields: [arenaId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])
  coach            User?             @relation("CoachBookings", fields: [coachId], references: [id])
  participants     BookingParticipant[]
  payment          Payment?

  @@index([courtId, startTime, endTime])
  @@index([arenaId, startTime])
}

model BookingParticipant {
  id          String            @id @default(uuid())
  bookingId   String
  userId      String?
  guestName   String?           // Atleta avulso de balcão
  pricePaid   Decimal           @db.Decimal(10, 2)
  status      ParticipantStatus @default(PENDING)
  createdAt   DateTime          @default(now())

  booking     Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user        User?             @relation(fields: [userId], references: [id])

  @@unique([bookingId, userId])
}

model StaffInvite {
  id          String       @id @default(uuid())
  email       String
  role        Role         // RECEPTIONIST ou TEACHER
  status      InviteStatus @default(PENDING)

  arenaId     String
  arena       Arena        @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User         @relation("SentInvites", fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("staff_invites")
}

model Payment {
  id            String          @id @default(uuid())
  description   String          // Ex: "Aluguel Quadra 1" ou "Venda de Água e Raquete"
  amount        Decimal         @db.Decimal(10, 2)
  method        PaymentMethod
  category      PaymentCategory @default(OTHER)
  status        PaymentStatus   @default(COMPLETED)
  paidAt        DateTime        @default(now())

  // Vinculo com a Arena
  arenaId       String
  arena         Arena           @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  // Vinculo Opcional com o Agendamento (se for pagamento de reserva)
  bookingId     String?         @unique
  booking       Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  // Vinculo Opcional com o Atleta/Cliente (se souber quem pagou)
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Funcionário / Admin que lançou o pagamento
  createdById   String
  createdBy     User            @relation("PaymentsCreated", fields: [createdById], references: [id])

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("payments")
}

model ArenaFollower {
  id        String   @id @default(uuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  arenaId   String
  arena     Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, arenaId])
  @@map("arena_followers")
}

model ArenaOperatingHour {
  id        String   @id @default(uuid())
  arenaId   String
  dayOfWeek Int      // 0 = Domingo, 1 = Segunda, ..., 6 = Sábado
  openTime  String   // Formato "HH:mm", ex: "06:00"
  closeTime String   // Formato "HH:mm", ex: "23:00"
  isOpen    Boolean  @default(true) // false = Não abre neste dia da semana
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  arena Arena @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@unique([arenaId, dayOfWeek])
}

model ArenaHoliday {
  id          String   @id @default(uuid())
  arenaId     String
  date        DateTime @db.Date // Data específica sem agendamento (ex: 2026-12-25)
  description String?  // Ex: "Natal", "Manutenção Geral"
  createdAt   DateTime @default(now())

  arena Arena @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@unique([arenaId, date])
}